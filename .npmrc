# GitHub Packages registry for the @lisandroalvo scope.
# The auth token is NOT required during local development or Storybook builds
# because @lisandroalvo/gfg-design-system is resolved via workspace:* protocol.
# NODE_AUTH_TOKEN is only needed during npm publish (handled by publish-package.yml).
# Never commit a real token here.

@lisandroalvo:registry=https://npm.pkg.github.com
