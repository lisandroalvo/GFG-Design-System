# GitHub Packages registry for the @lisandroalvo scope.
# This file configures pnpm (and npm) to resolve @lisandroalvo/* packages
# from GitHub Packages instead of the public npm registry.
#
# For local development or CI, set NODE_AUTH_TOKEN in the environment
# (a GitHub Personal Access Token with read:packages permission).
# Never commit a real token here.
#
# Example (add to your shell profile or CI secrets, NOT this file):
#   export NODE_AUTH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

@lisandroalvo:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
