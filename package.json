{
  "name": "design-system-live-app",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build:site": "vite build",
    "preview": "vite preview",
    "start": "node server.cjs",
    "sync-figma": "echo '🎨 Please ask Cascade: Sync all Figma changes and push to GitHub'",
    "build": "pnpm --filter @lisandroalvo/gfg-design-system build",
    "storybook": "pnpm --filter gfg-design-system-storybook storybook",
    "build:storybook": "pnpm --filter gfg-design-system-storybook build-storybook",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build && pnpm build:storybook"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "netlify-cli": "^25.6.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
