# GFG Design System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Figma Personal Access Token
# Generate at: https://www.figma.com/developers/api#access-tokens
# Rotate immediately if this value is ever exposed in a log or message.
FIGMA_TOKEN=your_figma_personal_access_token_here

# Figma File Key
# Found in the Figma file URL: figma.com/file/FILE_KEY/...
FIGMA_FILE_KEY=your_figma_file_key_here
